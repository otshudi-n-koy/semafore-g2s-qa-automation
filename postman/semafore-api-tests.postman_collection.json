    {
      "name": "GET Employees filtered by statut",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"All returned employees are actif\", function () {\r",
              "    const json = pm.response.json();\r",
              "    json.employees.forEach(emp => {\r",
              "        pm.expect(emp.statut).to.eql(\"actif\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees?statut=actif",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "employees"
          ],
          "query": [
            {
              "key": "statut",
              "value": "actif"
            }
          ]
        }
      },
      "response": []
    },
