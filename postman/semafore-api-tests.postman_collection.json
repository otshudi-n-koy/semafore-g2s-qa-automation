    {
      "name": "SEMA-15 GET Access rights duplicate detection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"SEMA-15 Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"SEMA-15 Detecte un doublon application/role\", function () {\r",
              "    const json = pm.response.json();\r",
              "    const seen = new Set();\r",
              "    let hasDuplicate = false;\r",
              "\r",
              "    json.rights.forEach(r => {\r",
              "        const key = `${r.application}|${r.role}`;\r",
              "        if (seen.has(key)) {\r",
              "            hasDuplicate = true;\r",
              "        }\r",
              "        seen.add(key);\r",
              "    });\r",
              "\r",
              "    pm.expect(hasDuplicate).to.be.true;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/access-rights/SI_MAT0001",
          "host": ["{{base_url}}"],
          "path": ["access-rights", "SI_MAT0001"]
        }
      },
      "response": []
    },
    {
      "name": "SEMA-16 GET Flux status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"SEMA-16 Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"SEMA-16 3 flux returned\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.flux.length).to.eql(3);\r",
              "});\r",
              "pm.test(\"SEMA-16 At least one flux has PARTIEL status\", function () {\r",
              "    const json = pm.response.json();\r",
              "    const hasPartiel = json.flux.some(f =>\r",
              "        f.etapes.some(e => e.statut === \"PARTIEL\")\r",
              "    );\r",
              "    pm.expect(hasPartiel).to.be.true;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/flux/status",
          "host": ["{{base_url}}"],
          "path": ["flux", "status"]
        }
      },
      "response": []
